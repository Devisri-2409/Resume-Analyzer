# =============================================================================
# ResumeAI Backend Environment Configuration Template
# =============================================================================

# AI Service Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Neon Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

# JWT Authentication Secret Key
JWT_SECRET_KEY=your_jwt_secret_key_here

# Initial Admin Credentials (seeded on startup if not present)
ADMIN_EMAIL=admin@resumeai.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Platform Administrator

# Frontend Application URL (used for verification links)
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Email Verification (SMTP Configuration)
# If SMTP_HOST is not set or SMTP credentials are blank, the service automatically
# runs in safe DEV mode (verification links are logged to console without failing).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=no-reply@resumeai.com
SMTP_TLS=True

# -----------------------------------------------------------------------------
# SMS OTP Verification (Twilio Configuration)
# Set SMS_PROVIDER=twilio to dispatch real SMS via Twilio.
# If SMS_PROVIDER=dev or credentials are unset, the service automatically runs
# in safe DEV mode (6-digit OTP codes are logged to console without failing).
# -----------------------------------------------------------------------------
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

